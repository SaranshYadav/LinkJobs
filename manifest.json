{
  "name": "LinkJobs",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "main.html",
    "default_icon": "linkjobs.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ],
  "host_permissions": [ "<all_urls>" ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": ["activeTab", "scripting"]
}